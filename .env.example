# ==========================================
# ConnectCRM Environment Variables
# ==========================================

# Port and Server Configuration
PORT=3000
NODE_ENV=development

# Cryptographic Master Key for AES-256-GCM (32-character string or 64-hex characters)
ENCRYPTION_KEY=replace_with_your_secure_32_byte_secret_key_here!

# Webhook Secrets (HMAC-SHA256)
WEBHOOK_SIGNING_SECRET=whsec_replace_with_your_hmac_signing_secret

# Role-Based Auth Session Secret
SESSION_SECRET=replace_with_your_jwt_session_secret_key_here

# External Mock Adapters
MOCK_SMS_PROVIDER_ENABLED=true
MOCK_CALENDAR_PROVIDER_ENABLED=true
MOCK_VOICE_GATEWAY_ENABLED=true

# Resend Email Delivery (Optional - for sending real password reset OTPs)
# RESEND_API_KEY=re_your_resend_api_key
# RESEND_FROM_EMAIL=ConnectCRM <onboarding@resend.dev>

# ==========================================
# Supabase Cloud Database Configuration
# ==========================================
# ConnectCRM works out-of-the-box locally with .data/db.json.
# To connect to Supabase, provide either the REST API credentials OR the PostgreSQL Connection String:

# Option A: Supabase REST API (Found in Supabase Dashboard -> Project Settings -> API)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_URL=https://your-project-ref.supabase.co
# Use your publishable key, anon key, or service_role key:
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your_supabase_publishable_key
SUPABASE_PUBLISHABLE_KEY=your_supabase_publishable_key
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_public_key
SUPABASE_ANON_KEY=your_supabase_anon_public_key
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_secret_key

# Option B: Supabase Direct/Pooled PostgreSQL Connection String (Found in Project Settings -> Database)
# Supports transaction pooler (port 6543) or direct session (port 5432)
# DATABASE_URL=postgresql://postgres.your-project-ref:your-db-password@aws-0-region.pooler.supabase.com:6543/postgres
# POSTGRES_URL=postgresql://postgres.your-project-ref:your-db-password@aws-0-region.pooler.supabase.com:6543/postgres
